{
  "name": "soundvault-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "start": "node index.js",
    "start:prod": "prisma db push --skip-generate && node index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:baseline": "prisma migrate resolve --applied 0_init",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:source:generate": "prisma generate --schema=prisma/source.prisma",
    "migrate:data": "tsx scripts/migrate-to-tidb.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@soundvault/shared": "file:../packages/shared",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.5",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.11.4",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.17.2",
    "prisma": "^5.22.0",
    "puppeteer": "^23.5.0",
    "sharp": "^0.33.5",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/uuid": "^10.0.0",
    "@vercel/functions": "^3.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  }
}
