// The Warehouse - Sistema de Gestión de Inventario de Audio
// Schema Prisma para Iglesia & Estudio de Grabación

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums del dominio
enum DeviceCategory {
  AUDIO_PA
  RECORDING_STUDIO
  INSTRUMENTS
  CABLES_ACCESSORIES
  LIGHTING
  MULTIMEDIA
}

enum DeviceStatus {
  ACTIVE
  MAINTENANCE
  DAMAGED
  LOST
  RETIRED
  LOANED
}

enum MovementType {
  CHECK_IN
  CHECK_OUT
  TRANSFER
  STATUS_CHANGE
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EventPhase {
  OUTBOUND
  INBOUND
}

enum EventListKind {
  CUSTOM
  CATEGORY
}

enum MovementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  MANAGER
  TECHNICIAN
  VIEWER
}

enum ExpenseCategory {
  PURCHASE       // Compra de equipo
  REPAIR         // Reparación
  MAINTENANCE    // Mantenimiento / servicio técnico
  ACCESSORY      // Accesorios / consumibles
  RENTAL         // Alquiler
  SERVICE        // Servicios (software, suscripciones)
  OTHER          // Otro
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  role         UserRole
  permissions  Json?     // Array de claves de permiso. Si null/empty se usan los del rol.
  avatar       String?   @db.Text
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  movements    Movement[]
  maintenances Maintenance[]
  loanApprovals LoanRecord[] @relation("ApprovedBy")
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  icon            String
  color           String
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  devices         Device[]
  usefulLifeYears Int?       // Vida útil en años (para depreciación lineal)
  createdAt       DateTime   @default(now())
}

model Tag {
  id      String   @id @default(cuid())
  name    String   @unique
  devices Device[]
}

// Lugares/ubicaciones: el usuario puede agregar, editar nombre y orden. Device.location y Movement usan el code.
model Location {
  id        String   @id @default(cuid())
  code      String   @unique  // MAIN_AUDITORIUM, STORAGE_ROOM, etc.
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Device {
  id             String          @id @default(cuid())
  name           String
  brand          String
  model          String
  serialNumber   String?         @unique
  internalCode   String          @unique
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status         DeviceStatus    @default(ACTIVE)
  location       String          @default("STORAGE_ROOM") @db.VarChar(64)
  purchaseDate   DateTime?
  purchasePrice  Decimal?        @db.Decimal(10, 2)
  warrantyExpiry DateTime?
  supplier       String?
  notes          String?         @db.Text
  observation    String?         @db.VarChar(500)
  condition      Int             @default(100)
  qrCode         String?         @db.Text
  isQrGenerated  Boolean         @default(false)
  createdBy      String
  lastCheckedAt  DateTime?
  deletedAt      DateTime?       // Soft delete
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  images         DeviceImage[]
  documents      Document[]
  movements      Movement[]
  maintenances   Maintenance[]
  loanRecords    LoanRecord[]
  expenses       Expense[]
  tags           Tag[]
  eventItems     EventItem[]
}

model DeviceImage {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  url       String   @db.VarChar(1000)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  name      String
  type      String   // factura, manual, garantia
  url       String   @db.VarChar(1000)
  createdAt DateTime @default(now())
}

model Movement {
  id           String         @id @default(cuid())
  deviceId     String
  device       Device         @relation(fields: [deviceId], references: [id])
  type         MovementType
  status       MovementStatus @default(APPROVED)
  fromLocation String?        @db.VarChar(64)
  toLocation   String?        @db.VarChar(64)
  reason       String
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  eventId      String?
  eventListId  String?
  approvedBy   String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([status])
  @@index([eventId])
}

model Maintenance {
  id          String    @id @default(cuid())
  deviceId    String
  device      Device    @relation(fields: [deviceId], references: [id])
  type        String
  description String    @db.Text
  cost        Decimal?  @db.Decimal(10, 2)
  technician  String?
  startDate   DateTime
  endDate     DateTime?
  status      String
  notes       String?   @db.Text
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
}

model LoanRecord {
  id              String    @id @default(cuid())
  deviceId        String
  device          Device    @relation(fields: [deviceId], references: [id])
  borrowerName    String
  borrowerEmail   String?
  borrowerPhone   String?
  purpose         String
  loanDate        DateTime
  expectedReturn  DateTime
  returnDate      DateTime?
  status          String
  approvedBy      String
  approvedByUser  User      @relation("ApprovedBy", fields: [approvedBy], references: [id])
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
}

// Gastos: contabilidad de inventario (compras, reparaciones, servicios, etc.)
model Expense {
  id            String          @id @default(cuid())
  date          DateTime
  amount        Decimal         @db.Decimal(14, 2)
  currency      String          @default("COP") // COP, USD
  category      ExpenseCategory @default(OTHER)
  description   String          @db.Text
  supplier      String?
  invoiceNumber String?
  paymentMethod String?
  deviceId      String?
  device        Device?         @relation(fields: [deviceId], references: [id])
  receiptUrl    String?         @db.VarChar(1000) // Comprobante adjunto (imagen o PDF)
  userId        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@index([category])
  @@index([deviceId])
}

// Presupuestos por período (mensual o anual) y categoría de gasto opcional.
model Budget {
  id        String           @id @default(cuid())
  year      Int
  month     Int?             // null = presupuesto anual; 1-12 = mensual
  category  ExpenseCategory? // null = todas las categorías
  amount    Decimal          @db.Decimal(14, 2)
  currency  String           @default("COP")
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([year, month])
}

// Audit trail - log de TODOS los cambios
model AuditLog {
  id         String   @id @default(cuid())
  entity     String   // Device, User, Maintenance, etc.
  entityId   String
  action     String   // CREATE, UPDATE, DELETE
  changes    Json?    // Campos cambiados
  userId     String?
  userEmail  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

// Destinatarios de alertas por correo (gestionados desde Configuración)
model AlertRecipient {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  label     String?  @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Eventos con una o más listas de equipos y checklist de salida/entrada.
model Event {
  id            String      @id @default(cuid())
  name          String
  eventDate     DateTime
  fromLocation  String      @db.VarChar(64)
  toLocation    String      @db.VarChar(64)
  status        EventStatus @default(DRAFT)
  currentPhase  EventPhase  @default(OUTBOUND)
  notes         String?     @db.Text
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lists         EventList[]
  items         EventItem[]
  scans         EventScan[]

  @@index([status])
  @@index([eventDate])
  @@map("InventoryEvent")
}

model EventList {
  id         String        @id @default(cuid())
  eventId    String
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  kind       EventListKind @default(CUSTOM)
  categoryId String?
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  items      EventItem[]

  @@index([eventId])
  @@map("InventoryEventList")
}

model EventItem {
  id                 String    @id @default(cuid())
  eventId            String
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  listId             String?
  list               EventList? @relation(fields: [listId], references: [id], onDelete: Cascade)
  deviceId           String
  device             Device    @relation(fields: [deviceId], references: [id])
  sortOrder          Int       @default(0)
  /// Ubicación real del equipo al verificar salida (para devolverlo ahí).
  originLocation     String?   @db.VarChar(64)
  outboundScannedAt  DateTime?
  outboundUserId     String?
  outboundUserName   String?
  inboundScannedAt   DateTime?
  inboundUserId      String?
  inboundUserName    String?
  outboundMovementId String?
  inboundMovementId  String?
  createdAt          DateTime  @default(now())

  @@unique([eventId, deviceId])
  @@index([eventId])
  @@index([listId])
  @@map("InventoryEventItem")
}

model EventScan {
  id             String     @id @default(cuid())
  eventId        String
  event          Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deviceId       String
  phase          EventPhase
  userId         String
  userName       String
  success        Boolean
  message        String?    @db.VarChar(500)
  deviceLocation String?    @db.VarChar(64)
  createdAt      DateTime   @default(now())

  @@index([eventId, phase])
  @@index([createdAt])
  @@map("InventoryEventScan")
}
