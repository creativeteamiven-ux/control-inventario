# ===========================================
# PRODUCCIÓN (API en Render + frontend en Vercel)
# No subas este archivo con valores reales. Configura las variables en:
# Render → Tu servicio → Environment
# ===========================================

# --- Obligatorias ---
# Cadena de conexión MySQL/TiDB (el schema de Prisma usa provider = "mysql").
DATABASE_URL=
# Secretos largos y aleatorios (mínimo 16 caracteres). El arranque falla si faltan.
JWT_SECRET=
REFRESH_SECRET=
PORT=3001
# URL(es) del frontend separadas por coma. CORS solo permitirá estos orígenes.
CLIENT_URL=https://thewarehouse.diosfuentedepoder.com

# --- Almacenamiento de archivos (obligatorio en producción) ---
# El disco del contenedor es efímero: sin Cloudinary las imágenes y comprobantes
# se pierden en cada despliegue y la API rechazará las subidas.
CLOUDINARY_URL=
# Alternativa a CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Recomendadas ---
# Dominio público del backend, para que las URLs de /uploads sean absolutas
# (necesario porque el frontend está en otro dominio).
PUBLIC_API_URL=
# Secreto propio para los tokens de autorización con PIN o biometría.
# Si se omite, se deriva de JWT_SECRET.
APPROVAL_SECRET=
# Fragmento del nombre del proyecto en Vercel para permitir previews (*.vercel.app).
PREVIEW_ORIGIN_PATTERN=
# Token para el cron externo de alertas (se envía en la cabecera x-cron-secret).
ALERT_CRON_SECRET=
